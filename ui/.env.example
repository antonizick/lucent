# Only needed for the optional email-triage feature — NERO's reflection loop,
# weekly curator, and auto-summarize run entirely on local Ollama and don't use this.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Discord Bot Configuration
DISCORD_BOT_TOKEN=your_bot_token_here
DISCORD_SERVER_ID=your_server_id_here
DISCORD_CHANNEL_ID=your_lucent_commands_channel_id
DISCORD_LOG_CHANNEL_ID=your_lucent_logs_channel_id
DISCORD_LOG_WEBHOOK_URL=your_log_webhook_url_here
# Optional: a second channel where messages go straight to Claude (see discord_bot.py). Leave unset to disable.
DISCORD_CLAUDE_CHANNEL_ID=your_claude_direct_channel_id

# Voice Box / server.py address — discord_monitor.py posts responses here. Must be 8001, NOT 8002 (that's the separate auth proxy).
BACKEND_URL=http://localhost:8001
LUCENT_ROOT=/home/nick/dev/lucent
