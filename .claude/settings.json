{
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "/home/nick/dev/lucent/scripts/lucent-init.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "curl -s -X POST http://localhost:8001/speak -H 'Content-Type: application/json' -d '{\"text\":\"Session complete.\",\"source\":\"sessionend\"}' 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
