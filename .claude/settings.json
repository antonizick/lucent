{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/nick/dev/lucent/scripts/guard_memory_write.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/nick/dev/lucent/scripts/startup.py",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/nick/dev/lucent/scripts/skill_read_tracker.py"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "/home/nick/dev/lucent/scripts/lucent-init.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/nick/dev/lucent/scripts/log_turn_end.py"
          },
          {
            "type": "command",
            "command": "python3 /home/nick/dev/lucent/scripts/reflect.py"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/nick/dev/lucent/scripts/pre_compact.py"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/nick/dev/lucent/scripts/log_session_end.py && curl -s -X POST http://localhost:8001/speak -H 'Content-Type: application/json' -d '{\"text\":\"Session complete.\",\"source\":\"sessionend\"}' 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
